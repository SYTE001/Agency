# Environment Variables Template
# Copy to .env and fill in real values. Never commit .env or config.yaml
# (they contain secrets).

# Database Provider:
#   DB_PROVIDER=postgresql (production / Supabase)
#   DB_PROVIDER=sqlite     (local fallback zero-config)
DB_PROVIDER=postgresql

# ── Database Connection Strings ─────────────────────────────────────────────
# RUNTIME: Supabase Supavisor SESSION pooler connection string on port 5432
# (Supports IPv4 networks, serverless functions, and local development):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# CLI / MIGRATIONS: Direct PostgreSQL connection string on port 5432
# Used by Prisma CLI (migrate deploy, migrate dev, db push):
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Local SQLite zero-config alternative:
# DATABASE_URL="file:./prisma/dev.db"
# DB_PROVIDER=sqlite

# ── System bootstrap (one-time, no business data) ───────────────────────────
# The seed creates ONLY the agency + one Owner account — never demo/business
# records; all business data is entered through the app UI.
#
# Local development (SQLite):
#   OWNER_EMAIL="owner@agency.test" OWNER_PASSWORD="min-12-chars" npx prisma db seed
#
# Production (PostgreSQL) uses the dedicated script instead:
#   OWNER_PASSWORD='…' npx tsx scripts/bootstrap-owner.mts
# The password is passed via the environment only (or OWNER_PASSWORD_FILE=…),
# hashed with the app's scrypt implementation, and never stored or printed.
# NEVER write a real password into this file.
# OWNER_EMAIL=owner@agency.test
# OWNER_PASSWORD=
# Optional overrides for `prisma db seed`:
# AGENCY_NAME=Kreatif Nusantara
# AGENCY_SLUG=kreatif-nusantara
# OWNER_NAME=Agency Owner

# Session signing secret — REQUIRED in production, minimum 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="your-secret-key-at-least-32-chars-long"

# ── Testing only ────────────────────────────────────────────────────────────
# npm test NEVER uses the ambient DATABASE_URL. Without TEST_DATABASE_URL it
# runs on a throwaway SQLite file in the OS temp dir (isolated, repeatable).
# To run the suite against a DEDICATED PostgreSQL test database instead, set
# TEST_DATABASE_URL — it MUST point at a dedicated /agency-os-test-db
# database (never a shared/production one; the run aborts otherwise):
#   1. CREATE DATABASE "agency-os-test-db";
#   2. DIRECT_URL=postgres://…/agency-os-test-db npx prisma migrate deploy --schema prisma/schema.prisma
#   3. TEST_DATABASE_URL=postgres://…/agency-os-test-db npm test
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/agency-os-test-db

# ── Mock sync (development/demo ONLY) ───────────────────────────────────────
# The settings/integrations page ships a SIMULATED TikTok sync that writes
# fake CreatorMetric rows (it never touches campaigns or other business
# data). It is refused unless BOTH hold:
#   1. MOCK_SYNC_ENABLED=true   ← explicit opt-in, default is off
#   2. NODE_ENV != production   ← production rejects mock sync outright,
#                                 even if the flag is left set by accident
# MOCK_SYNC_ENABLED=true
